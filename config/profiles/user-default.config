# name: user default
# publish: yes
# The integration's default (USB audio, no boot logo) made to fit with the least loss to the sound
# (docs/HANDOFF-fm1.md suggestion: LOFI and VOICE out, the delay at 0.74 s), then the SCRATCH sample set
# (23 KB: the SCRATCH preset; the set can still be uploaded to a USR slot). Every other set and kit, the icons,
# VIEW ALL and FM6's OPL mode stay.
# With the SLOOP 2.3 fixes (on by default: stricter flash checks, USB MIDI flow control, the overload fade, keys
# ~1 ms sooner, the knobs' one rest state, TRS MIDI past line noise, the restore's checks: ~1.2 KB), FM6's operator
# editor in VIEW ALL goes too (1 KB: the operators' pages one at a time). The boot logo and FM6's algorithm full
# screen (ENV held), out for a while to fit, are back since the large font is the small one at scale 2 (-24.7 KB)
# and SLOOP's dead HOME screen went (2026-10-06).
ENG_LOFI=0
ENG_FORMANT=0
DLY_LEN=32768
SET_SCRCH=0
FM6_ALL=0
# the reverb's lines (17 KB) in the pool, which has room here: main RAM is the scarcer (same sound)
REV_POOL=1
PATTERNS=1
