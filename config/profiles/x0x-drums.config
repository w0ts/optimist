# name: x0x drums
# publish: no
# The drum machine with both X0X kits (909, 808) and the drum synth's kits; ANALOG 2, SAMPLE, SLICE and ACID. Off to fit:
# DIGITAL, PHASE, LOFI, VOICE, TRIO, WHEEL, GRAIN, FM6, the sampled kits and every sample set (each can still be uploaded
# to a USR slot); the delay at 0.74 s and the reverb's lines in the pool; the CDC console.
# 2026-10-19: the user's refit (config/my-profiles/x0x drums.config) after SLOOP's UI went (the profile had it: +22 KB)
# firmware builder configuration (tools/builder/registry.py keys; others take their defaults)
# Synth engines
ENG_DIGITAL=0
ENG_PHASE=0
ENG_LOFI=0
ENG_FORMANT=0
ENG_TRIO=0
ENG_DRAWBAR=0
ENG_GRAIN=0
ENG_FM6=0
ENG_SLICE=0
ENG_ACID=1
# Drums
DRUM_SAMPLED=0
DRUM_X0X909=1
DRUM_X0X808=1
# Sample sets
SET_PIANO=0
SET_BASS=0
SET_VIBES=0
SET_HORNS=0
SET_STRGS=0
SET_FLUTE=0
SET_SCRCH=0
# FX: limited instances (once, or a set count)
DLY_LEN=32768
REV_POOL=1
# Sequencer
PATTERNS=1
# MIDI & USB
USB_CONSOLE=0
USB_AUDIO=1
# COND (step conditions) brings the automation store, so the drum ACCENT lane (2026-10-20)
COND=1
ED_LIVE=0
FX_PUNCH=0
BT_AUDIO=1
UART=1
DS_PLAITS=0
