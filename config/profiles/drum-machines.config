# name: drum machine
# publish: yes
# Drums first: the X0X 909 and 808 kits, the drum synth with KAWA and PLAITS, the sampled kits and drum EDIT; SAMPLE and
# GRAIN for the tracks. USB audio + MIDI, Bluetooth MIDI (devices at FULL) and Bluetooth audio, the web editor (backup,
# librarian, the screen mirror), the help line, PATTERNS, live save. Off: every other synth engine (ANALOG 2, FM6, DIGITAL
# and the rest), every sample set (each can still be uploaded to a USR slot), the note generators and GRIDS.
# Memory management
LAYOUT=2
# Synth engines
ENG_ANALOG=0
A2_LADR=1
A2_OTA=1
A2_DIOD=1
A2_MS20=1
ENG_DIGITAL=2
DIG_TONE=1
ENG_PHASE=0
ENG_LOFI=0
ENG_SAMPLE=0
ENG_FORMANT=0
ENG_TRIO=0
ENG_DRAWBAR=0
ENG_GRAIN=0
ENG_FM6=0
FM6_PK_KEYS=1
FM6_PK_BASS=1
FM6_PK_BELLS=1
FM6_PK_PADS=1
FM6_PK_80S=1
UP_FM6=1
# Drums
DRUM_X0X909=1
X909_CYM=2
X0X_TANH=2
DRUM_X0X808=1
DRUM_USR=0
# Sample sets
SET_PIANO=0
SET_BASS=0
SET_VIBES=0
SET_HORNS=0
SET_STRGS=0
SET_FLUTE=0
SET_SCRCH=0
# FX
DLY_LEN=32768
REV_ROOM=0
REV_FDN8=1
FX_PUNCH=0
PUNCH_N=16384
FX_DJF=0
FX_DUST=0
MASTER_COMP=0
INS_FOLD=1
INS_FUZZ=1
INS_HARM=1
INS_FLANGER=1
INS_GATER=1
# Sequencer
SNAPSHOTS=0
PATTERNS=1
REC_PLAIN=1
NOTEGEN=1
CHANCE=1
QNT_SEQ=1
MOTION=1
SL24_XSTEP=1
MICRO=1
FILLS=1
COND=1
SEQTOOLS=1
GEN_GRIDS=1
GRIDS_EUCLID=1
GRIDS_LFO=1
GRIDS_VEL=1
# Connectivity
USB_AUDIO=1
MIDI_EXPR=0
MIDI_NOTEOUT=0
BLE_CENTRAL=1
# UI
FAVORITES=0
PARAM_HELP=1
LCD_BAUD=0
DIV_ORDER=1
# System
EDITOR=0
ED_LIVE=0
ED_MIX=0
ED_SEQ=0
ED_SCREENS=0
ED_MIRROR=1
LIVE_SAVE=1
CPU_GUARD=1
SL24_SAFE=0
