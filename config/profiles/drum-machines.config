# name: drum machine
# publish: yes
# ANALOG 2 for bass, SAMPLE, GRAIN, SLICE; the X0X 909 and 808 kits beside the drum synth and the sampled kits; USB audio +
# MIDI; the help line. Off: DIGITAL, PHASE, LOFI, VOICE, TRIO, WHEEL, FM6; every sample set (each can still be uploaded to
# a USR slot); the web editor.
# 2026-10-19: the user's refit (config/my-profiles/drum machine.config) after SLOOP's UI went (the profile had it: +30 KB)
# Synth engines
ENG_ANALOG=0
ENG_DIGITAL=0
ENG_PHASE=0
ENG_LOFI=0
ENG_FORMANT=0
ENG_TRIO=0
ENG_DRAWBAR=0
ENG_FM6=0
# Drums
DRUM_X0X909=1
X909_CYM=0
X909_HAT=2
X0X_TANH=2
DRUM_X0X808=1
# Sample sets
SET_PIANO=0
SET_BASS=0
SET_VIBES=0
SET_HORNS=0
SET_STRGS=0
SET_FLUTE=0
SET_SCRCH=0
# FX: any number (each track its own)
FX_DJF=0
FX_DUST=0
MASTER_COMP=0
INS_FOLD=1
INS_FUZZ=1
INS_WIDTH=1
INS_RECT=1
INS_SUBOCT=1
INS_TAPE=1
# FX: limited instances (once, or a set count)
DLY_LEN=32768
REV_ROOM=0
REV_FDN8=1
FX_PUNCH=0
PUNCH_N=16384
INS_DELAY=1
# Sequencer
SNAPSHOTS=0
PATTERNS=1
COND=1
# USB & BT & MIDI
USB_AUDIO=1
MIDI_EXPR=0
MIDI_NOTEOUT=0
BLE=1
BLE_CENTRAL=1
BT_AUDIO=1
# UI
FAVORITES=0
PARAM_HELP=1
LCD_BAUD=0
BRIGHT=0
DIV_ORDER=1
# System
ED_LIVE=0
ED_MIX=0
ED_SEQ=0
ED_SCREENS=0
ED_MIRROR=1
TAB_IN_POOL=1
LIVE_SAVE=1
CPU_GUARD=1
SL24_SAFE=0
SL24_IMPORT=0
