     rev[4] = 0;
+    copy_trim(inq_vendor, vendor, sizeof(inq_vendor));
+    copy_trim(inq_product, product, sizeof(inq_product));
     dlog("INQUIRY OK: vendor=\"%s\" product=\"%s\" rev=\"%s\"", vendor, product, rev);
     return true;
 }
