+// An INQUIRY string without its padding, inner spaces as '_': one word in `status`.
+static void copy_trim(char *dst, const char *src, size_t size) {
+    size_t n = strlen(src);
+    while (n && src[n - 1] == ' ') n--;
+    if (n >= size) n = size - 1;
+    for (size_t i = 0; i < n; i++) dst[i] = src[i] == ' ' ? '_' : src[i];
+    dst[n] = 0;
+}
+
+const char *fm1_host_inquiry_vendor(void) { return inq_vendor[0] ? inq_vendor : "-"; }
+const char *fm1_host_inquiry_product(void) { return inq_product[0] ? inq_product : "-"; }
