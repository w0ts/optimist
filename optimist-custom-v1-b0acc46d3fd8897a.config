# name: custom-v1
# firmware builder configuration (tools/builder/registry.py keys; others take their defaults)
# Synth engines
ENG_DIGITAL=0
ENG_PHASE=0
ENG_LOFI=0
ENG_FORMANT=0
ENG_TRIO=0
ENG_DRAWBAR=0
ENG_GRAIN=0
ENG_FM6=0
ENG_JUNO=1
# Sample sets
SET_BASS=0
SET_VIBES=0
SET_HORNS=0
SET_FLUTE=0
SET_SCRCH=0
# FX: any number (each track its own)
TRK_FILT=1
# FX: limited instances (once, or a set count)
PUNCH_N=16384
SPRING=1
# Sequencer
PATTERNS=1
CHANCE=1
MOTION=1
REC_MODES=1
SL24_XSTEP=1
MICRO=1
PLOCK=1
SEQTOOLS=1
# MIDI & USB
USB_MODE=1
# UI
LIGHTS=1
